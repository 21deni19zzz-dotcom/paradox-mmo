---
import DefaultLayout from '../layouts/default.astro';
import '../scss/main.scss';
---

<DefaultLayout title="Недоступно">
    <div id="intro">
        <section id="parchment" class="slice-menu">
            <article id="unavailable-screen">
                <h1 class="title-decoration">Paradox Online</h1>

                <p>
                    Сервер временно недоступен. Мы работаем над восстановлением —
                    попробуйте зайти немного позже.
                    <br /><br />
                    Следите за новостями в нашем магазине:
                    <a
                        target="_blank"
                        rel="noopener noreferrer"
                        href="https://t.me/ParadoxxShop_bot">@ParadoxxShop_bot</a
                    >.
                </p>
            </article>
        </section>
    </div>
</DefaultLayout>

<style is:global>
    #unavailable-screen {
        pointer-events: auto;
        opacity: 1;

        p {
            margin-top: 3em;
        }
    }
</style>
